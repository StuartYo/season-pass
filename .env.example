# Copy to .env.local for local development. Never commit real values.

# Optional. Turns on Claude mode in the simulator and is required by eval/baseline.ts.
# Without it, everything runs in rules mode with no AI calls.
AMAZON_ANTHROPIC_API_KEY=

# Optional. Caps for the public demo's Claude mode (US dollars, reset at midnight UTC / each month).
# When one is reached, the simulator falls back to rules mode. Durable only with Upstash; otherwise per server instance.
DAILY_COST_CAP_USD=0.75
MONTHLY_COST_CAP_USD=2
DEMO_DAILY_USD_PER_VISITOR=0.35
DEMO_DAILY_STEPS_PER_VISITOR=40

# Optional. Durable household state across serverless instances (Upstash Redis REST).
# Without it: local JSON files in .data/ (dev) or /tmp (Vercel, not durable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
