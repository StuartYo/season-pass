# Copy to .env.local for local development. Never commit real values.

# Optional. Turns on Claude mode in the simulator and is required by eval/baseline.ts.
# Without it, everything runs in rules mode with no AI calls.
AMAZON_ANTHROPIC_API_KEY=

# Optional. Daily spend cap for the public demo's Claude mode, in US dollars.
DAILY_COST_CAP_USD=2

# Optional. Durable household state across serverless instances (Upstash Redis REST).
# Without it: local JSON files in .data/ (dev) or /tmp (Vercel, not durable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
